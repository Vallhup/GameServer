{
  "schemaVersion": 2,
  "objectName": "FinalBoss",
  "inputs": {
    "meshDirectory": "../../Resource/Final_Boss/Mesh",
    "animationDirectory": "../../Resource/Final_Boss/Animation"
  },
  "outputs": {
    "capsuleTemplatePath": "../../Output/Capsule/final_boss_capsule_template.json",
    "animationDirectory": "../../Output/Animation/Final_Boss"
  },
  "capsuleRules": {
    "defaultRoles": [ "hurt" ],
    "weaponRoles": [ "hit" ],
    "weaponBones": [ 45 ]
  },
  "clips": [
    { "name": "dashslash", "source": "boss_animation_attack_dashslash_baked.bone", "output": "final_boss_animation_dashslash.json", "loop": false },
    { "name": "jumpslash", "source": "boss_animation_attack_jumpslash_baked.bone", "output": "final_boss_animation_jumpslash.json", "loop": false },
    { "name": "multislash", "source": "boss_animation_attack_multislash_baked.bone", "output": "final_boss_animation_multislash.json", "loop": false },
    { "name": "slash", "source": "boss_animation_attack_slash_baked.bone", "output": "final_boss_animation_slash.json", "loop": false },
    { "name": "thrust", "source": "boss_animation_attack_thrust_baked.bone", "output": "final_boss_animation_thrust.json", "loop": false },
    { "name": "idle", "source": "boss_animation_idle_baked.bone", "output": "final_boss_animation_idle.json", "loop": true },
    { "name": "walk", "source": "boss_animation_walk_baked.bone", "output": "final_boss_animation_walk.json", "loop": true }
  ]
}
